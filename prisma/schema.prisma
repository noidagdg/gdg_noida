generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ApplicationStatus {
  DRAFT
  SUBMITTED
}

enum Track {
  BUSINESS_FAIR
  STARTUPS_PROJECTS_OSS
  HARDWARE_PROJECTS
  ROBO_RACE_WAR
}

enum ApplicantType {
  STUDENT
  WORKING_PROFESSIONAL
  ENTREPRENEUR_FOUNDER
  OTHER
}

model Application {
  id                  String            @id @default(cuid())
  accessToken         String            @unique @default(cuid())
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
  submittedAt         DateTime?
  status              ApplicationStatus @default(DRAFT)
  currentStep         Int               @default(1)
  selectedTrack       Track?
  name                String?
  email               String?
  phoneNumber         String?
  applicantType       ApplicantType?
  organizationName    String?
  city                String?
  teamName            String?
  numberOfTeamMembers Int?
  teamMembers         TeamMember[]
  businessFair        BusinessFairDetails?
  startupProject      StartupProjectDetails?
  hardwareProject     HardwareProjectDetails?
  roboDetails         RoboDetails?
  projectImages       ProjectImage[]

  @@index([status])
  @@index([selectedTrack])
}

model TeamMember {
  id            String      @id @default(cuid())
  applicationId String
  name          String
  emailOrContact String
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([applicationId])
}

model BusinessFairDetails {
  id                       String      @id @default(cuid())
  applicationId            String      @unique
  businessName             String?
  founderName              String?
  businessCategory         String?
  businessDescription      String?
  showcaseDescription      String?
  socialMediaUrl           String?
  stallRequirements        String[]    @default([])
  specialRequirements      String?
  additionalInformation    String?
  application              Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
}

model StartupProjectDetails {
  id                       String      @id @default(cuid())
  applicationId            String      @unique
  showcaseType             String?
  projectName              String?
  oneLineDescription       String?
  problemStatement         String?
  solutionDescription      String?
  techStack                String?
  currentStage             String?
  githubUrl                String?
  liveDemoUrl              String?
  showcaseRequirements     String[]    @default([])
  additionalInformation    String?
  application              Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
}

model HardwareProjectDetails {
  id                       String      @id @default(cuid())
  applicationId            String      @unique
  projectName              String?
  oneLineDescription       String?
  problemStatement         String?
  projectDescription       String?
  hardwareComponents       String?
  techStack                String?
  currentStage             String?
  demoUrl                  String?
  setupRequirements        String[]    @default([])
  specialRequirements      String?
  additionalInformation    String?
  application              Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
}

model RoboDetails {
  id                       String      @id @default(cuid())
  applicationId            String      @unique
  teamName                 String?
  organizationName         String?
  competitionCategory      String?
  robotName                String?
  robotSpecifications      String?
  powerSourceDetails       String?
  controllerDetails        String?
  robotDescription         String?
  demoUrl                  String?
  equipmentRequirements    String[]    @default([])
  specialRequirements      String?
  application              Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
}

model ProjectImage {
  id            String      @id @default(cuid())
  applicationId String
  createdAt     DateTime    @default(now())
  filename      String
  mimeType      String
  size          Int
  data          Bytes
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([applicationId])
}
